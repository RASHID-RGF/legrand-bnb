<%- include('partials/head', { title, active, description }) %>
<%- include('partials/header', { active: 'properties' }) %>

<section class="detail-hero">
  <div class="container">
    <div class="crumbs" style="justify-content:flex-start;color:var(--muted)">
      <a href="/">Home</a> / <a href="/properties">Properties</a> / <span><%= property.title %></span>
    </div>

    <!-- Gallery -->
    <div class="gallery-grid <%= property.images.length <= 3 ? 'g3' : '' %> reveal visible">
      <% property.images.slice(0, 5).forEach((img, i) => { %>
      <div class="g-item" data-gallery="<%= escapeJson(property.images) %>" data-start="<%= i %>">
        <img src="<%= img %>" alt="<%= property.title %> photo <%= i + 1 %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
        <% if (i === 3 && property.images.length > 5) { %>
        <div class="gallery-more">+<%= property.images.length - 4 %> photos</div>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<main class="section" style="padding-top:0">
  <div class="container">
    <div class="detail-body">

      <!-- ============ LEFT ============ -->
      <div class="detail-content">
        <div class="detail-head">
          <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin-bottom:.6rem">
            <% if (property.featured) { %><span class="card-ribbon">✦ Featured</span><% } %>
            <% if (property.category) { %><span class="badge badge-gold"><%= property.category %></span><% } %>
            <span class="verified-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg> Verified listing</span>
          </div>
          <h1><%= property.title %></h1>
          <div class="detail-meta">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= property.location %>, <%= property.subCounty %>, <%= property.county %></span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Sleeps <%= property.guests %></span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9h18v12H3z"/><path d="M3 13h18"/><path d="M8 9V5"/><path d="M16 9V5"/></svg> <%= property.bedrooms %> bedrooms</span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12h16v8H4z"/><path d="M7 12V7a5 5 0 0 1 10 0v5"/></svg> <%= property.bathrooms %> bathrooms</span>
            <% if (property.rating) { %><span class="rating"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> <%= property.rating %> (<%= property.reviews %> reviews)</span><% } %>
          </div>
        </div>

        <h2 style="font-size:1.4rem;margin:2rem 0 1rem">About this stay</h2>
        <p style="color:var(--ink-soft);white-space:pre-line"><%= property.description %></p>

        <h2 style="font-size:1.4rem;margin:2.4rem 0 1rem">What this place offers</h2>
        <div class="amenity-grid">
          <% (property.amenities || []).forEach(a => { %>
          <div class="amenity">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
            <%= a %>
          </div>
          <% }) %>
        </div>

        <h2 style="font-size:1.4rem;margin:2.4rem 0 1rem">Good to know</h2>
        <div class="info-grid">
          <div class="info-tile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <div><b>Check-in</b><span><%= property.checkIn || 'Based on client time' %></span></div>
          </div>
          <div class="info-tile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <div><b>Check-out</b><span><%= property.checkOut || '11:00 AM' %></span></div>
          </div>
          <div class="info-tile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <div><b>Sleeps</b><span><%= property.guests %> guests</span></div>
          </div>
          <div class="info-tile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9h18v12H3z"/><path d="M3 13h18"/><path d="M8 9V5"/><path d="M16 9V5"/></svg>
            <div><b>Type</b><span><%= property.propertyType %></span></div>
          </div>
        </div>

        <% if (property.highlights && property.highlights.length) { %>
        <h2 style="font-size:1.4rem;margin:2.4rem 0 1rem">Highlights</h2>
        <ul class="rules-list">
          <% property.highlights.forEach((h) => { %>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg><span><%= h %></span></li>
          <% }) %>
        </ul>
        <% } %>

        <% if (property.houseRules && property.houseRules.length) { %>
        <h2 style="font-size:1.4rem;margin:2.4rem 0 1rem">House rules</h2>
        <ul class="rules-list">
          <% property.houseRules.forEach((r) => { %>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg><span><%= r %></span></li>
          <% }) %>
        </ul>
        <% } %>

        <h2 style="font-size:1.4rem;margin:2.4rem 0 1rem">Location</h2>
        <div class="map-embed" style="margin-top:0">
          <div id="detail-map" data-lat="<%= property.lat || 0.061 %>" data-lng="<%= property.lng || 34.288 %>" data-title="<%= property.title %>" style="height:360px"></div>
        </div>
      </div>

      <!-- ============ RIGHT CARD ============ -->
      <aside class="detail-card reveal visible">
        <div class="price-row">
          <b><%= money(property.pricePerNight) %></b><span>/ night</span>
        </div>

        <div class="contact-stack">
          <a class="btn btn-whatsapp" href="https://wa.me/<%= property.whatsapp %>?text=Hello!%20I%20found%20your%20property%20%22<%= encodeURIComponent(property.title) %>%22%20on%20LeGrand%20and%20I%27d%20love%20to%20know%20more." target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.11 3.22 5.1 4.51.71.31 1.27.5 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.35zM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.9 7c0 5.44-4.44 9.87-9.9 9.87zm8.42-18.3A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L.07 24l6.33-1.66a11.88 11.88 0 0 0 5.65 1.44c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.4z"/></svg>
            WhatsApp <%= property.phone %>
          </a>
          <a class="btn btn-whatsapp" href="https://wa.me/<%= property.whatsapp2 || waNumber(property.phone2) %>?text=Hello!%20I%20found%20your%20property%20%22<%= encodeURIComponent(property.title) %>%22%20on%20LeGrand%20and%20I%27d%20love%20to%20know%20more." target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.11 3.22 5.1 4.51.71.31 1.27.5 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.35zM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.9 7c0 5.44-4.44 9.87-9.9 9.87zm8.42-18.3A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L.07 24l6.33-1.66a11.88 11.88 0 0 0 5.65 1.44c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.4z"/></svg>
            WhatsApp <%= property.phone2 %>
          </a>
          <a class="btn btn-phone" href="tel:<%= property.phone %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call <%= property.phone %>
          </a>
          <% if (property.phone2) { %>
          <a class="btn btn-phone" href="tel:<%= property.phone2 %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call <%= property.phone2 %>
          </a>
          <% } %>
          <a class="btn btn-email" href="mailto:<%= property.email %>?subject=Enquiry%20about%20<%= encodeURIComponent(property.title) %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            Send an Email
          </a>
        </div>

        <div class="host-note">
          ✦ No booking fees — contact the owner directly and arrange your stay in one chat.
        </div>

        <div class="share-row">
          <span>Share:</span>
          <button data-share data-title="<%= property.title %>" aria-label="Share" style="color:var(--green-600)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/></svg></button>
          <button data-share title="Link" aria-label="Copy link" style="color:var(--muted)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
        </div>
      </aside>
    </div>

    <!-- ============ RELATED ============ -->
    <% if (related.length) { %>
    <section style="margin-top:4rem">
      <div class="section-head" style="margin-bottom:2rem">
        <span class="eyebrow">You might also like</span>
        <h2>Similar Stays</h2>
      </div>
      <div class="grid-cards">
        <% related.forEach((p, i) => { %>
          <div class="reveal d<%= (i % 3) + 1 %>"><%- include('partials/property-card', { p }) %></div>
        <% }) %>
      </div>
    </section>
    <% } %>
  </div>
</main>

<%- include('partials/footer', { settings }) %>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  (function () {
    const el = document.getElementById('detail-map');
    if (!el || typeof L === 'undefined') return;
    const lat = Number(el.dataset.lat) || 0.061;
    const lng = Number(el.dataset.lng) || 34.288;
    const map = L.map(el).setView([lat, lng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);
    L.marker([lat, lng])
      .addTo(map)
      .bindPopup('<b>' + el.dataset.title + '</b><br>' + '<%= property.location %>, <%= property.subCounty %>')
      .openPopup();
  })();
</script>
</body>
</html>
