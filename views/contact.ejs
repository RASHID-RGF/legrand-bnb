<%- include('partials/head', { title, active }) %>
<%- include('partials/header', { active }) %>

<section class="page-hero">
  <div class="container">
    <div class="crumbs"><a href="/">Home</a> / <span>Contact</span></div>
    <h1>Get in Touch</h1>
    <p>Questions, feedback or want to list your property? We'd love to hear from you.</p>
  </div>
</section>

<main class="section">
  <div class="container">
    <% if (flash) { %>
    <div class="alert alert-success" style="max-width:760px;margin:0 auto 1.6rem"><%= flash %></div>
    <% } %>

    <div class="contact-grid">
      <!-- Info card -->
      <div class="contact-info-card reveal reveal-left">
        <h2>Contact Information</h2>
        <ul class="ci-list">
          <li>
            <div class="ci-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
            <div><b>Visit us</b><small><%= settings.address %></small></div>
          </li>
          <li>
            <div class="ci-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
            <div><b>Call us</b><small><a href="tel:<%= settings.contactPhone %>" style="color:inherit"><%= settings.contactPhone %></a></small></div>
          </li>
          <li>
            <div class="ci-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></div>
            <div><b>Email us</b><small><a href="mailto:<%= settings.contactEmail %>" style="color:inherit"><%= settings.contactEmail %></a></small></div>
          </li>
          <li>
            <div class="ci-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.11 3.22 5.1 4.51.71.31 1.27.5 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.35zM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.9 7c0 5.44-4.44 9.87-9.9 9.87zm8.42-18.3A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L.07 24l6.33-1.66a11.88 11.88 0 0 0 5.65 1.44c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.4z"/></svg></div>
            <div><b>WhatsApp <%= settings.contactPhone || '+254 723 865 139' %></b><small><a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" style="color:inherit">Chat with us now →</a></small></div>
          </li>
          <li>
            <div class="ci-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.11 3.22 5.1 4.51.71.31 1.27.5 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.35zM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.9 7c0 5.44-4.44 9.87-9.9 9.87zm8.42-18.3A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L.07 24l6.33-1.66a11.88 11.88 0 0 0 5.65 1.44c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.4z"/></svg></div>
            <div><b>WhatsApp <%= settings.contactPhone2 || '+254 725 317 246' %></b><small><a href="https://wa.me/<%= settings.whatsapp2 || waNumber(settings.contactPhone2) %>" target="_blank" rel="noopener" style="color:inherit">Chat with us now →</a></small></div>
          </li>
        </ul>
      </div>

      <!-- Form -->
      <div class="contact-form-card reveal reveal-right">
        <h2 style="font-size:1.4rem;margin-bottom:1.4rem">Send us a message</h2>
        <form id="contact-form" action="/api/contact" method="POST">
          <div class="form-grid">
            <div class="form-field">
              <label for="c-name">Your name *</label>
              <input type="text" id="c-name" name="name" required placeholder="e.g. Jane Wanjiru">
            </div>
            <div class="form-field">
              <label for="c-phone">Phone</label>
              <input type="tel" id="c-phone" name="phone" placeholder="+254 7XX XXX XXX">
            </div>
            <div class="form-field">
              <label for="c-email">Email</label>
              <input type="email" id="c-email" name="email" placeholder="you@email.com">
            </div>
            <div class="form-field">
              <label for="c-subject">Subject</label>
              <select id="c-subject" name="subject">
                <option>General enquiry</option>
                <option>Advertise my property</option>
                <option>Property enquiry</option>
                <option>Feedback</option>
                <option>Partnership</option>
              </select>
            </div>
            <div class="form-field full">
              <label for="c-message">Message *</label>
              <textarea id="c-message" name="message" rows="6" required placeholder="Tell us how we can help…"></textarea>
            </div>
            <div class="form-field full">
              <button type="submit" class="btn btn-primary" style="justify-content:center">Send Message <span>→</span></button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Map -->
    <div class="map-embed reveal">
      <iframe
        src="https://maps.google.com/maps?q=Siaya%20Town,%20Kenya&t=&z=12&ie=UTF8&iwloc=&output=embed"
        loading="lazy"
        title="LeGrand office location — Siaya Town"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</main>

<%- include('partials/footer', { settings }) %>
<script>
  (function () {
    const form = document.getElementById('contact-form');
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]');
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries());
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('Request failed');
        LeGrandToast('Message sent! We\u2019ll be in touch soon ✓');
        form.reset();
      } catch (err) {
        LeGrandToast('Oops — please try again.');
      }
    });
  })();
</script>
</body>
</html>
