<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'LeGrand' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'LeGrand — Discover Exceptional Stays Across Siaya. Browse verified properties, view photos and contact owners directly.' %>">
  <meta name="theme-color" content="#0a3d2c">
  <link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg">
  <link rel="apple-touch-icon" href="/static/img/logo.svg">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Leaflet (interactive map) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <!-- Styles -->
  <link rel="stylesheet" href="/static/css/style.css">

  <!-- Inline theme to avoid flash -->
  <script>
    (function () {
      try {
        var s = localStorage.getItem('legrand-theme');
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', s || d);
      } catch (e) {}
    })();
  </script>
</head>
<body>
