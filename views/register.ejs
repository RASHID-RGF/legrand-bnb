<%- include('partials/head', { title, active }) %>
<div class="login-page">
  <div class="login-card reveal visible">
    <a href="/" class="brand"><img src="/static/img/logo.svg" alt="LeGrand"><span>Le<em>Grand</em></span></a>
    <h1>Create Your Account</h1>
    <p>Join LeGrand to explore verified stays across Siaya County.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form action="/register?next=<%= encodeURIComponent(next) %>" method="POST" id="register-form" novalidate>
      <div class="form-field" style="margin-bottom:1rem">
        <label for="r-name">Full name</label>
        <input type="text" id="r-name" name="name" required placeholder="e.g. Jane Wanjiru" autofocus>
      </div>
      <div class="form-field" style="margin-bottom:1rem">
        <label for="r-email">Email</label>
        <input type="email" id="r-email" name="email" required placeholder="you@email.com">
      </div>
      <div class="form-field" style="margin-bottom:1rem">
        <label for="r-password">Password</label>
        <input type="password" id="r-password" name="password" required minlength="6" placeholder="At least 6 characters">
      </div>
      <div class="form-field" style="margin-bottom:1.4rem">
        <label for="r-password2">Confirm password</label>
        <input type="password" id="r-password2" name="confirmPassword" required placeholder="Repeat your password">
        <small id="pw-hint" style="color:#c0392b;display:none;font-size:.8rem">Passwords do not match.</small>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    </form>

    <div style="text-align:center;margin-top:1.2rem;font-size:.9rem;color:var(--muted)">
      Already have an account? <a href="/login?next=<%= encodeURIComponent(next) %>" style="color:var(--gold-600);font-weight:700">Sign in →</a>
    </div>
    <div style="text-align:center;margin-top:.6rem">
      <a href="/" style="font-size:.85rem;color:var(--muted)">← Back to home</a>
    </div>
  </div>
</div>
<script>
  (function () {
    var form = document.getElementById('register-form');
    var pw = document.getElementById('r-password');
    var pw2 = document.getElementById('r-password2');
    var hint = document.getElementById('pw-hint');

    function check() {
      var ok = pw.value === pw2.value;
      hint.style.display = pw2.value ? (ok ? 'none' : 'block') : 'none';
      return ok;
    }

    pw2.addEventListener('input', check);
    form.addEventListener('submit', function (e) {
      if (!check()) e.preventDefault();
    });
  })();
</script>
</body>
</html>
