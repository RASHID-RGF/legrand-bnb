<%- include('partials/head', { title, active }) %>
<div class="login-page">
  <div class="login-card reveal visible">
    <a href="/" class="brand"><img src="/static/img/logo.svg" alt="LeGrand"><span>Le<em>Grand</em></span></a>
    <h1>Welcome Back</h1>
    <p>Sign in to browse properties, contact owners and save favourites.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

    <form action="/login?next=<%= encodeURIComponent(next) %>" method="POST">
      <div class="form-field" style="margin-bottom:1rem">
        <label for="u-email">Email</label>
        <input type="email" id="u-email" name="email" required placeholder="you@email.com" autofocus>
      </div>
      <div class="form-field" style="margin-bottom:1.4rem">
        <label for="u-password">Password</label>
        <input type="password" id="u-password" name="password" required placeholder="••••••••">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>

    <div style="text-align:center;margin-top:1.2rem;font-size:.9rem;color:var(--muted)">
      New to LeGrand? <a href="/register?next=<%= encodeURIComponent(next) %>" style="color:var(--gold-600);font-weight:700">Create an account →</a>
    </div>
    <div style="text-align:center;margin-top:.6rem">
      <a href="/" style="font-size:.85rem;color:var(--muted)">← Back to home</a>
    </div>
  </div>
</div>
</body>
</html>
