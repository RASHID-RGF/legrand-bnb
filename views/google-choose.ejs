<%- include('partials/head', { title, active }) %>
<div class="login-page">
  <div class="login-card account-choose reveal visible">
    <a href="/" class="brand"><img src="/static/img/logo.svg" alt="LeGrand"><span>Le<em>Grand</em></span></a>
    <h1>Choose your account</h1>
    <p>Pick the Google account you want to sign in with.</p>

    <% if (accounts.length > 0) { %>
    <div class="account-list">
      <% accounts.forEach((acc) => { %>
      <form action="/auth/google" method="POST" class="account-option">
        <input type="hidden" name="login_hint" value="<%= esc(acc.email) %>">
        <input type="hidden" name="next" value="<%= esc(next) %>">
        <button type="submit" class="account-row" aria-label="Continue with <%= esc(acc.email) %>">
          <% if (acc.picture) { %>
          <img class="account-avatar" src="<%= esc(acc.picture) %>" alt="" loading="lazy">
          <% } else { %>
          <span class="account-avatar account-initial"><%= esc(String(acc.name || acc.email || '?').trim().charAt(0).toUpperCase()) %></span>
          <% } %>
          <span class="account-meta">
            <b><%= esc(acc.name || 'Google account') %></b>
            <span><%= esc(acc.email) %></span>
          </span>
          <svg class="account-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </button>
      </form>
      <% }) %>
    </div>
    <% } else { %>
    <p class="account-empty">No Google accounts have signed in here yet — use the button below to continue to Google and pick any account.</p>
    <% } %>

    <div class="divider"><span>or</span></div>

    <form action="/auth/google" method="POST">
      <input type="hidden" name="next" value="<%= esc(next) %>">
      <button type="submit" class="btn btn-google btn-block">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"/><path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/></svg>
        Use a different Google account
      </button>
    </form>

    <div style="text-align:center;margin-top:1.2rem;font-size:.9rem;color:var(--muted)">
      Prefer email &amp; password? <a href="/login?next=<%= encodeURIComponent(next) %>" style="color:var(--gold-600);font-weight:700">Sign in instead →</a>
    </div>
    <div style="text-align:center;margin-top:.6rem">
      <a href="/" style="font-size:.85rem;color:var(--muted)">← Back to home</a>
    </div>
  </div>
</div>
</body>
</html>
