<% const body = `
<div class="admin-panel">
  <div class="panel-head">
    <h2>Registered Users</h2>
    <span class="badge badge-gold">${users.length} total</span>
  </div>
  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>User</th><th>Email</th><th>Joined</th><th>Last Login</th><th style="text-align:right">Actions</th></tr></thead>
      <tbody>
        ${users.length ? users.map(u => `
        <tr>
          <td>
            <div class="tbl-prop">
              <span style="width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--gold-500);color:var(--green-950);font-weight:800;font-size:.95rem;flex-shrink:0">${(u.name || 'U').trim().charAt(0).toUpperCase()}</span>
              <div><b>${u.name || '—'}</b><small>id: ${u.id}</small></div>
            </div>
          </td>
          <td>${u.email || '—'}</td>
          <td>${u.createdAt ? formatDate(u.createdAt) : '—'}</td>
          <td>${u.lastLoginAt ? formatDate(u.lastLoginAt) : '<span class="badge badge-muted">never</span>'}</td>
          <td>
            <div class="row-actions" style="justify-content:flex-end">
              <form action="/admin/users/${u.id}/delete" method="POST" data-confirm="Delete ${u.email || 'this user'}? Their account will be removed and they will be signed out.">
                <button class="btn btn-sm" style="color:#c0392b;border:1.5px solid #f5c6c6;border-radius:999px">Delete</button>
              </form>
            </div>
          </td>
        </tr>`).join('') : '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:2.4rem">No users have signed up yet.</td></tr>'}
      </tbody>
    </table>
  </div>
</div>
`; %>
<%- include('partials/shell', { title, active, admin, unreadCount: 0, body }) %>
