<% const body = `
<div class="admin-panel">
  <div class="panel-head">
    <h2>Contact Enquiries</h2>
    <span class="badge badge-gold">${enquiries.filter(e => !e.read).length} unread</span>
  </div>
  <div class="panel-body">
    ${enquiries.length ? enquiries.map(e => `
      <div class="enquiry-item ${e.read ? '' : 'unread'}" style="display:flex;gap:1.2rem;padding:1.1rem 0;border-bottom:1px solid var(--line);${e.read ? 'opacity:.72' : ''}">
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:.7rem;flex-wrap:wrap">
            <b style="font-size:1.02rem">${e.name}</b>
            ${e.read ? '' : '<span class="badge badge-gold">new</span>'}
            <span style="font-size:.8rem;color:var(--muted)">${formatDate(e.createdAt)}</span>
          </div>
          <div style="font-size:.85rem;color:var(--green-600);margin:.15rem 0 .35rem">${e.subject}</div>
          <p style="font-size:.92rem;color:var(--ink-soft);white-space:pre-wrap">${e.message}</p>
          <div style="display:flex;gap:1.2rem;margin-top:.5rem;font-size:.82rem;color:var(--muted);flex-wrap:wrap">
            ${e.email ? `<span>✉ ${e.email}</span>` : ''}
            ${e.phone ? `<span>☎ ${e.phone}</span>` : ''}
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:.5rem;flex-shrink:0">
          ${e.read ? '' : `<a class="btn btn-ghost btn-sm mark-read" href="/admin/enquiries/${e.id}/read">Mark read</a>`}
          <form action="/admin/enquiries/${e.id}/delete" method="POST" data-confirm="Delete this enquiry?" style="display:inline">
            <button class="btn btn-sm" style="color:#c0392b;border:1.5px solid #f5c6c6;border-radius:999px">Delete</button>
          </form>
        </div>
      </div>`).join('') : '<p style="color:var(--muted);text-align:center;padding:2rem">No enquiries yet — they will appear here when visitors use the contact form.</p>'}
  </div>
</div>
`; %>
<%- include('partials/shell', { title, active, admin, unreadCount: enquiries.filter(e => !e.read).length, body }) %>
