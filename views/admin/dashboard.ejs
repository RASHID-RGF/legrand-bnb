<% const body = `
<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-ico green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg></div>
    <div><b>${stats.properties}</b><span>Total Properties</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-ico gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg></div>
    <div><b>${stats.featured}</b><span>Featured Listings</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-ico blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h7l9 9-7 7-9-9z"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"/></svg></div>
    <div><b>${stats.categories}</b><span>Categories</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-ico red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
    <div><b>${stats.enquiries}</b><span>Enquiries <small style="color:#c0392b">(${stats.unread} unread)</small></span></div>
  </div>
</div>

<div class="admin-panel">
  <div class="panel-head">
    <h2>Latest Properties</h2>
    <a href="/admin/properties" class="btn btn-ghost btn-sm">Manage all</a>
  </div>
  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>Property</th><th>Price/Night</th><th>Location</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead>
      <tbody>
        ${latestProperties.map(p => `
        <tr>
          <td><div class="tbl-prop"><img src="${p.images[0] || '/static/img/placeholder.svg'}" alt=""><div><b>${p.title}</b><small>${p.propertyType}</small></div></div></td>
          <td><b>$${Number(p.pricePerNight).toLocaleString()}</b></td>
          <td>${p.location}, ${p.subCounty}</td>
          <td>${p.featured ? '<span class="badge badge-gold">Featured</span>' : '<span class="badge badge-muted">Standard</span>'}</td>
          <td><div class="row-actions">
            <a class="mini-btn" href="/properties/${p.slug}" target="_blank" title="View"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
            <a class="mini-btn" href="/admin/properties/${p.id}/edit" title="Edit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg></a>
          </div></td>
        </tr>`).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:2rem">No properties yet — <a href="/admin/properties/new">add your first</a>.</td></tr>'}
      </tbody>
    </table>
  </div>
</div>

<div class="admin-panel">
  <div class="panel-head">
    <h2>Recent Enquiries</h2>
    <a href="/admin/enquiries" class="btn btn-ghost btn-sm">View all</a>
  </div>
  <div class="panel-body">
    ${recentEnquiries.length ? recentEnquiries.map(e => `
      <div class="enquiry-item" style="display:flex;align-items:center;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--line)">
        <div style="flex:1"><b>${e.name}</b> ${e.read ? '' : '<span class="badge badge-gold" style="margin-left:.4rem">new</span>'}
          <div style="font-size:.85rem;color:var(--muted)">${e.subject}</div></div>
        <div style="font-size:.82rem;color:var(--muted)">${formatDate(e.createdAt)}</div>
        <a class="mini-btn mark-read" href="/admin/enquiries/${e.id}/read" title="Mark read"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg></a>
      </div>`).join('') : '<p style="color:var(--muted)">No enquiries yet.</p>'}
  </div>
</div>
`; %>
<%- include('partials/shell', { title, active, admin, unreadCount: stats.unread, body }) %>
