<% const body = `
<div class="admin-panel">
  <div class="panel-head">
    <h2>Property Categories</h2>
    <span class="badge badge-muted">${categories.length} categories</span>
  </div>
  <div class="panel-body">
    <form action="/admin/categories" method="POST" style="display:flex;gap:.7rem;margin-bottom:1.6rem;flex-wrap:wrap">
      <input type="text" name="name" required placeholder="New category name (e.g. Beachfront)" style="flex:1;min-width:200px;padding:.7rem 1rem;border-radius:10px;border:1.5px solid var(--line);background:var(--bg-soft);color:var(--ink)">
      <button type="submit" class="btn btn-primary">Add Category</button>
    </form>

    <div style="display:grid;gap:.7rem">
      ${categories.map(c => `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.1rem;border:1px solid var(--line);border-radius:12px;background:var(--bg-soft)">
          <div style="display:flex;align-items:center;gap:.8rem">
            <span class="badge badge-gold">${c}</span>
            <small style="color:var(--muted)">${propertyCounts[c] || 0} properties</small>
          </div>
          <form action="/admin/categories/delete" method="POST" data-confirm="Delete category &quot;${c}&quot;? Properties keep their category name but it will no longer be filterable." style="display:inline">
            <input type="hidden" name="name" value="${c}">
            <button class="mini-btn danger" type="submit" title="Delete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
          </form>
        </div>`).join('') || '<p style="color:var(--muted)">No categories yet.</p>'}
    </div>
  </div>
</div>
`; %>
<%- include('partials/shell', { title, active, admin, body }) %>
