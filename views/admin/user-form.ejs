<%- include('shell', { title, page }) %>

  <div class="admin-top">
    <div>
      <h1><%= user ? 'Edit user' : 'New user' %></h1>
      <p><%= user ? esc(user.email) : 'Create an account manually.' %></p>
    </div>
    <a href="/admin/users" class="btn btn-ghost btn-sm">← Back to users</a>
  </div>

  <% if (error) { %><div class="alert alert-error" style="margin-bottom:1.5rem"><%= error %></div><% } %>

  <div class="admin-panel">
    <div class="panel-body">
      <form method="POST" action="<%= user ? '/admin/users/' + encodeURIComponent(user.id) : '/admin/users' %>" class="admin-form">
        <div class="form-field">
          <label for="f-name">Name</label>
          <input type="text" id="f-name" name="name" required value="<%= user ? esc(user.name || '') : '' %>" placeholder="Jane Wanjala">
        </div>
        <div class="form-field">
          <label for="f-email">Email</label>
          <input type="email" id="f-email" name="email" required value="<%= user ? esc(user.email || '') : '' %>" placeholder="jane@email.com">
        </div>
        <div class="form-field">
          <label for="f-password">Password <%= user ? '(leave blank to keep current)' : '' %></label>
          <input type="password" id="f-password" name="password" <%= user ? '' : 'required' %> minlength="6" placeholder="••••••••">
        </div>
        <div class="form-field">
          <label for="f-provider">Sign-in method</label>
          <select id="f-provider" name="provider">
            <option value="local" <%= user && user.provider === 'google' ? '' : 'selected' %>>Password</option>
            <option value="google" <%= user && user.provider === 'google' ? 'selected' : '' %>>Google</option>
          </select>
        </div>
        <div class="full" style="display:flex;gap:.8rem">
          <button type="submit" class="btn btn-primary"><%= user ? 'Save changes' : 'Create user' %></button>
          <a href="/admin/users" class="btn btn-ghost">Cancel</a>
        </div>
      </form>
    </div>
  </div>

</main>
</div>
</body>
</html>
