<%
const p = property;
const isEdit = !!p;
const amenitiesPool = ['WiFi','Free Parking','Kitchen','Hot Water','Air Conditioning','Garden','BBQ Grill','Smart TV','Security','Pool','Balcony','Fireplace','Breakfast','Housekeeping','Generator Backup','Outdoor Dining'];
const selected = (p && p.amenities) || [];
const body = `
<form method="POST" action="${isEdit ? '/admin/properties/' + p.id : '/admin/properties'}" enctype="multipart/form-data" class="admin-form">
  <div class="form-field">
    <label>Title *</label>
    <input type="text" name="title" required value="${p ? p.title.replace(/"/g, '&quot;') : ''}" placeholder="e.g. KIBOKO">
  </div>
  <div class="form-field">
    <label>Price per night (USD) *</label>
    <input type="number" name="pricePerNight" required min="0" value="${p ? p.pricePerNight : ''}" placeholder="e.g. 8500">
  </div>

  <div class="form-field">
    <label>Property type *</label>
    <input type="text" name="propertyType" required list="prop-types" value="${p ? p.propertyType : ''}" placeholder="e.g. Cottage, Villa, Apartment">
    <datalist id="prop-types"><option>Cottage</option><option>Villa</option><option>Apartment</option><option>Studio</option><option>Lodge</option><option>Bungalow</option><option>Guesthouse</option><option>Country House</option></datalist>
  </div>
  <div class="form-field">
    <label>Category</label>
    <select name="category">
      ${categories.map(c => `<option ${p && p.category === c ? 'selected' : ''}>${c}</option>`).join('')}
      <option ${p && !categories.includes(p.category) ? 'selected' : ''} ${!p ? 'selected' : ''}>None</option>
    </select>
  </div>

  <div class="form-row-3">
    <div class="form-field">
      <label>Bedrooms</label>
      <input type="number" name="bedrooms" min="0" value="${p ? p.bedrooms : 1}">
    </div>
    <div class="form-field">
      <label>Bathrooms</label>
      <input type="number" name="bathrooms" min="0" value="${p ? p.bathrooms : 1}">
    </div>
    <div class="form-field">
      <label>Max guests</label>
      <input type="number" name="guests" min="1" value="${p ? p.guests : 2}">
    </div>
  </div>

  <div class="form-row-3">
    <div class="form-field">
      <label>Location (town/village)</label>
      <input type="text" name="location" value="${p ? p.location : ''}" placeholder="e.g. Siaya Town">
    </div>
    <div class="form-field">
      <label>Sub-county</label>
      <input type="text" name="subCounty" value="${p ? p.subCounty : ''}" placeholder="e.g. Siaya Town">
    </div>
    <div class="form-field">
      <label>County</label>
      <input type="text" name="county" value="${p ? p.county : 'Siaya'}">
    </div>
  </div>

  <div class="form-row-3">
    <div class="form-field">
      <label>Phone</label>
      <input type="text" name="phone" value="${p ? p.phone : ''}" placeholder="+254 7XX XXX XXX">
    </div>
    <div class="form-field">
      <label>WhatsApp (no +, e.g. 2547XX...)</label>
      <input type="text" name="whatsapp" value="${p ? p.whatsapp : ''}" placeholder="254712345678">
    </div>
    <div class="form-field">
      <label>Email</label>
      <input type="email" name="email" value="${p ? p.email : ''}" placeholder="owner@email.com">
    </div>
  </div>

  <div class="form-row-3">
    <div class="form-field">
      <label>Instagram</label>
      <input type="url" name="instagram" value="${p ? p.instagram || '' : ''}" placeholder="https://instagram.com/your-handle">
    </div>
    <div class="form-field">
      <label>TikTok</label>
      <input type="url" name="tiktok" value="${p ? p.tiktok || '' : ''}" placeholder="https://tiktok.com/@your-handle">
    </div>
    <div class="form-field">
      <label>Facebook</label>
      <input type="url" name="facebook" value="${p ? p.facebook || '' : ''}" placeholder="https://facebook.com/your-page">
    </div>
  </div>

  <div class="form-row-3">
    <div class="form-field">
      <label>Latitude (for map)</label>
      <input type="number" step="any" name="lat" value="${p && p.lat ? p.lat : ''}" placeholder="0.061">
    </div>
    <div class="form-field">
      <label>Longitude (for map)</label>
      <input type="number" step="any" name="lng" value="${p && p.lng ? p.lng : ''}" placeholder="34.2886">
    </div>
    <div class="form-field" style="display:flex;flex-direction:row;align-items:center;gap:.8rem">
      <label style="margin:0">Featured</label>
      <label class="switch">
        <input type="checkbox" name="featured" ${p && p.featured ? 'checked' : ''}>
        <span class="slider"></span>
      </label>
    </div>
  </div>

  <div class="form-field full">
    <label>Description *</label>
    <textarea name="description" rows="7" required placeholder="Describe the property, surroundings and experience...">${p ? p.description : ''}</textarea>
  </div>

  <div class="form-field full">
    <label>Amenities</label>
    <div class="check-list">
      ${amenitiesPool.map(a => `
        <label class="check-pill">
          <input type="checkbox" name="amenities" value="${a}" ${selected.includes(a) ? 'checked' : ''}> ${a}
        </label>`).join('')}
    </div>
  </div>

  <div class="form-field full">
    <label>Photos</label>
    ${isEdit && p.images.length ? `
    <div class="thumb-grid">
      ${p.images.map(img => `
        <div class="thumb">
          <img src="${img}" alt="">
          <input type="hidden" name="existingImages" value="${img}">
          <span class="thumb-x" data-remove="${img}">✕</span>
        </div>`).join('')}
    </div>` : ''}
    <div class="upload-box" style="margin-top:1rem">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/></svg>
      <p><b>Click to upload images</b> (JPG/PNG/WebP, up to 12)</p>
      <input type="file" id="image-upload" name="images" accept="image/*" multiple style="display:none">
    </div>
    <div class="thumb-grid" id="upload-preview" style="margin-top:1rem"></div>
    <input type="hidden" id="removed-images" name="removedImages" value="">
  </div>

  <div class="form-field full" style="display:flex;gap:.8rem;margin-top:.6rem">
    <button type="submit" class="btn btn-primary">${isEdit ? 'Save Changes' : 'Create Property'}</button>
    <a href="/admin/properties" class="btn btn-ghost">Cancel</a>
  </div>
</form>
`; %>
<%- include('partials/shell', { title, active, admin, body, notice: typeof notice !== 'undefined' ? notice : null, error: typeof error !== 'undefined' ? error : null }) %>
