<% const current = typeof active !== 'undefined' ? active : ''; %>
<%- include('../../partials/head', { title, active }) %>
<div class="admin-body">
  <div class="admin-shell">
    <aside class="admin-side">
      <a href="/admin" class="brand"><img src="/static/img/logo.svg" alt="LeGrand"><span>Le<em>Grand</em></span></a>
      <nav class="admin-nav">
        <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
          Dashboard
        </a>
        <a href="/admin/properties" class="<%= active === 'properties' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
          Properties
        </a>
        <a href="/admin/properties/new" class="<%= active === 'new-property' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          Add Property
        </a>
        <a href="/admin/categories" class="<%= active === 'categories' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h7l9 9-7 7-9-9z"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"/></svg>
          Categories
        </a>
        <a href="/admin/enquiries" class="<%= active === 'enquiries' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Enquiries
          <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="badge badge-gold" style="margin-left:auto"><%= unreadCount %></span><% } %>
        </a>
      </nav>
      <div class="side-foot">
        <a href="/" target="_blank" class="admin-nav" style="display:block;color:rgba(255,255,255,.75);font-size:.85rem;padding:.5rem .9rem;border-radius:10px">↗ View site</a>
        <form action="/admin/logout" method="POST">
          <button type="submit" style="width:100%;display:flex;align-items:center;gap:.6rem;padding:.6rem .9rem;border-radius:10px;color:rgba(255,255,255,.75);font-size:.9rem" onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background=''">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:18px;height:18px"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
            Logout
          </button>
        </form>
        <p style="margin-top:.8rem;padding:0 .9rem;font-size:.72rem;color:rgba(255,255,255,.45)">Signed in as <b style="color:var(--gold-400)"><%= admin.name %></b></p>
      </div>
    </aside>

    <main class="admin-main">
      <div class="admin-top">
        <div>
          <h1><%- title.replace(' — LeGrand Admin', '') %></h1>
          <p>Welcome back, <%= admin.name.split(' ')[0] %> 👋</p>
        </div>
        <button class="icon-btn" data-theme-toggle aria-label="Toggle dark mode" style="border-color:var(--line);color:var(--ink)">
          <svg class="theme-icon-sun" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>

      <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="notice alert alert-success" style="margin-bottom:1.4rem"><%= notice %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" style="margin-bottom:1.4rem"><%= error %></div>
      <% } %>

      <%- body %>
    </main>
  </div>
</div>
<script src="/static/js/main.js"></script>
<script src="/static/js/admin.js"></script>
</body>
</html>
