<% const body = `
<div style="display:flex;justify-content:flex-end;margin-bottom:1.4rem">
  <a href="/admin/properties/new" class="btn btn-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" style="width:18px;height:18px"><path d="M12 5v14M5 12h14"/></svg> Add Property</a>
</div>

<div class="admin-panel">
  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>Property</th><th>Price/Night</th><th>Bedrooms</th><th>Location</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead>
      <tbody>
        ${properties.map(p => `
        <tr>
          <td><div class="tbl-prop"><img src="${p.images[0] || '/static/img/placeholder.svg'}" alt=""><div><b>${p.title}</b><small>${p.propertyType} · ${(p.amenities||[]).length} amenities</small></div></div></td>
          <td><b>KSh ${Number(p.pricePerNight).toLocaleString()}</b></td>
          <td>${p.bedrooms}</td>
          <td>${p.location}, ${p.subCounty}</td>
          <td>${p.featured ? '<span class="badge badge-gold">✦ Featured</span>' : '<span class="badge badge-muted">Standard</span>'}</td>
          <td><div class="row-actions">
            <form action="/admin/properties/${p.id}/toggle-featured" method="POST" style="display:inline" title="${p.featured ? 'Remove from featured' : 'Feature this'}">
              <button class="mini-btn" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg></button>
            </form>
            <a class="mini-btn" href="/properties/${p.slug}" target="_blank" title="View"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
            <a class="mini-btn" href="/admin/properties/${p.id}/edit" title="Edit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg></a>
            <form action="/admin/properties/${p.id}/delete" method="POST" style="display:inline" data-confirm="Delete this property permanently?">
              <button class="mini-btn danger" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
            </form>
          </div></td>
        </tr>`).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:2.5rem">No properties yet — <a href="/admin/properties/new">add your first</a>.</td></tr>'}
      </tbody>
    </table>
  </div>
</div>
`; %>
<%- include('partials/shell', { title, active, admin, body }) %>
