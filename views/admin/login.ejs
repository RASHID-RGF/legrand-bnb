<%- include('../partials/head', { title, active }) %>
<div class="login-page">
  <div class="login-card reveal visible">
    <a href="/" class="brand"><img src="/static/img/logo.svg" alt="LeGrand"><span>Le<em>Grand</em></span></a>
    <h1>Admin Sign In</h1>
    <p>Manage properties, categories and enquiries</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

    <form action="/admin/login" method="POST">
      <div class="form-field" style="margin-bottom:1rem">
        <label for="a-email">Email</label>
        <input type="email" id="a-email" name="email" required placeholder="admin@legrand.co.ke" autofocus>
      </div>
      <div class="form-field" style="margin-bottom:1.4rem">
        <label for="a-password">Password</label>
        <input type="password" id="a-password" name="password" required placeholder="••••••••">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>

    <div class="demo-hint">
      <b>Demo credentials:</b> admin@legrand.co.ke / admin123
    </div>
    <div style="text-align:center;margin-top:1.2rem">
      <a href="/" style="font-size:.85rem;color:var(--muted)">← Back to site</a>
    </div>
  </div>
</div>
</body>
</html>
