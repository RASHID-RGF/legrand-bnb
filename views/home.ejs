<%- include('partials/head', { title, active }) %>

<!-- Preloader -->
<div class="preloader">
  <div>
    <div class="pre-logo"><img src="/static/img/logo.svg" alt="LeGrand"></div>
    <div class="pre-bar"></div>
  </div>
</div>

<%- include('partials/header', { active }) %>

<main>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=2000&auto=format&fit=crop" alt="Lake Victoria, Siaya">
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-badge reveal visible">✦ ★ Rated 4.9 by local travellers</div>
      <h1 class="reveal visible d1">Discover Exceptional Stays<br><em>Across Siaya.</em></h1>
      <p class="hero-sub reveal visible d2">Browse verified homes, cottages and villas across Siaya Town — view honest photos, compare stays, and contact owners directly. No middlemen. No booking fees.</p>

      <form class="hero-search reveal visible d3" action="/properties" method="GET">
        <div class="field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
          <div style="width:100%">
            <label for="hero-q">Search</label>
            <input type="text" id="hero-q" name="q" placeholder="Cottage, villa, bungalow…" autocomplete="off">
          </div>
        </div>
        <div class="field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div style="width:100%">
            <label for="hero-loc">Where in Siaya?</label>
            <select id="hero-loc" name="location">
              <option value="all">Anywhere</option>
              <% ['Siaya Town'].forEach(l => { %>
              <option value="<%= l %>"><%= l %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-gold">Search Stays <span>→</span></button>
      </form>

      <div class="hero-stats reveal visible d4">
        <div class="stat"><b data-count="4" data-suffix="+">0</b><span>Curated Stays</span></div>
        <div class="stat"><b data-count="2" data-suffix="">0</b><span>Prime Locations</span></div>
        <div class="stat"><b data-count="100" data-suffix="%">0</b><span>Verified Listings</span></div>
        <div class="stat"><b data-count="4.9" data-suffix="★">0</b><span>Average Rating</span></div>
      </div>
    </div>
    <div class="scroll-hint"></div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee">
    <div class="marquee-track">
      <% for (let i = 0; i < 2; i++) { %>
        <% destinations.forEach(d => { %><span><%= d.name %> <b>·</b></span><% }) %>
      <% } %>
    </div>
  </div>

  <!-- ============ FEATURED PROPERTIES ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Handpicked for you</span>
        <h2>Featured Properties</h2>
        <p>Our four signature stays in Siaya Town — chosen for their character, comfort and glowing reviews.</p>
      </div>
      <div class="grid-cards">
        <% featured.forEach((p, i) => { %>
          <div class="reveal d<%= (i % 4) + 1 %>"><%- include('partials/property-card', { p }) %></div>
        <% }) %>
      </div>
      <div style="text-align:center;margin-top:2.5rem" class="reveal">
        <a href="/properties" class="btn btn-primary">Browse All Properties <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ CATEGORIES ============ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Find your vibe</span>
        <h2>Browse by Category</h2>
        <p>From family-friendly hideaways to luxury villas — every stay has its own story.</p>
      </div>
      <div class="cat-grid">
        <% const catImages = { 'Family': 'photo-1510798831971-661eb04b3739', 'Luxury': 'photo-1613490493576-7fde63acd811', 'Budget': 'photo-1522708323590-d24dbb6b0267' }; %>
        <% categories.forEach((c, i) => { %>
        <a href="/properties?category=<%= encodeURIComponent(c) %>" class="cat-tile reveal d<%= i + 1 %>">
          <img src="https://images.unsplash.com/<%= catImages[c] || 'photo-1506744038136-46273834b3fb' %>?q=80&w=900&auto=format&fit=crop" alt="<%= c %>" loading="lazy">
          <span class="cat-count"><%= propertiesByCategory && propertiesByCategory[c] || 0 %> stays</span>
          <div class="cat-label"><h3><%= c %></h3><p>Explore →</p></div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============ DESTINATIONS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Explore Siaya</span>
        <h2>Popular Destinations</h2>
        <p>Stay near Siaya Hotel or Siaya Prisons — pick a spot and start exploring.</p>
      </div>
      <div class="dest-grid">
        <% destinations.slice(0, 8).forEach((d, i) => { %>
        <a href="/properties?location=<%= encodeURIComponent(d.name) %>" class="dest-card reveal d<%= (i % 4) + 1 %>">
          <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=700&auto=format&fit=crop" alt="<%= d.name %>" loading="lazy">
          <div class="dest-info">
            <h3><%= d.name %></h3>
            <p><%= d.tag %></p>
            <small><%= d.count %> properties</small>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============ WHY LEGRAND ============ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why LeGrand?</span>
        <h2>The Smarter Way to Stay</h2>
      </div>
      <div class="feature-grid">
        <div class="feature-tile reveal">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg></div>
          <h3>Verified Listings</h3>
          <p>Every property is vetted by our team. What you see in the photos is exactly what you get.</p>
        </div>
        <div class="feature-tile reveal d1">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></div>
          <h3>High Quality Photos</h3>
          <p>Professionally shot galleries so you can picture your stay before you arrive.</p>
        </div>
        <div class="feature-tile reveal d2">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
          <h3>Direct Contact</h3>
          <p>Chat with owners on WhatsApp or call them directly. No middlemen, no extra fees.</p>
        </div>
        <div class="feature-tile reveal d3">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><path d="M9 10h.01M15 10h.01"/></svg></div>
          <h3>Discover Local Stays</h3>
          <p>Uncover Siaya’s best stays — from boutique cottages to luxury villas near Siaya Hotel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MAP + CONTACT ============ -->
  <section class="section">
    <div class="container">
      <div class="map-split reveal">
        <div class="map-panel-home">
          <div id="home-map"></div>
          <div class="map-legend">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Every pin below is an exact stay location in Siaya Town.
          </div>
        </div>
        <div class="map-contact">
          <span class="eyebrow" style="color:var(--gold-400)">Find us & talk to us</span>
          <h2>Where Our Stays Are</h2>
          <p>Tap a pin to see each stay, then reach the owner directly — call, WhatsApp or follow on social. No middlemen, no booking fees.</p>
          <% if (isAuthed) { %>
          <div class="contact-stack">
            <a class="btn btn-phone" href="tel:<%= (settings.contactPhone || '').replace(/\s+/g, '') %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call <%= settings.contactPhone %>
            </a>
            <a class="btn btn-phone" href="tel:<%= (settings.contactPhone2 || '+254 725 317 246').replace(/\s+/g, '') %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call <%= settings.contactPhone2 || '+254 725 317 246' %>
            </a>
            <a class="btn btn-whatsapp" href="https://wa.me/<%= settings.whatsapp %>?text=Hello%20LeGrand!%20I%20found%20you%20on%20the%20site%20and%20I%27d%20like%20to%20know%20more." target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.11 3.22 5.1 4.51.71.31 1.27.5 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.35zM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.9 7c0 5.44-4.44 9.87-9.9 9.87zm8.42-18.3A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L.07 24l6.33-1.66a11.88 11.88 0 0 0 5.65 1.44c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.4z"/></svg>
              WhatsApp <b style="margin-left:auto">→</b>
            </a>
          </div>
          <div class="social-row" style="margin-top:1.6rem">
            <a href="<%= settings.social.instagram || '#' %>" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
            <a href="<%= settings.social.tiktok || '#' %>" aria-label="TikTok" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg></a>
            <a href="<%= settings.social.facebook || '#' %>" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          </div>
          <% } else { %>
          <div class="locked-prompt">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <b>Sign in to call, WhatsApp or follow LeGrand</b>
            <a href="/login?next=/">Sign in →</a>
          </div>
          <% } %>
          <p style="font-size:.85rem;color:rgba(255,255,255,.6);margin-top:1.4rem">Own a property nearby? <a href="/contact" style="color:var(--gold-400);font-weight:700">Become a host →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Traveller love</span>
        <h2>What Guests Say</h2>
      </div>
      <div class="testi-wrap reveal">
        <div class="testi-track">
          <% testimonials.forEach((t) => { %>
          <div class="testi-slide">
            <div class="testi-avatar"><%= t.name.split(' ').map(w => w[0]).join('').slice(0,2) %></div>
            <div class="testi-stars"><% for (let i = 0; i < 5; i++) { %><%= i < t.rating ? '★' : '☆' %><% } %></div>
            <p class="testi-quote">“<%= t.quote %>”</p>
            <div class="testi-author"><b><%= t.name %></b><span><%= t.role %></span></div>
          </div>
          <% }) %>
        </div>
        <div class="testi-nav">
          <button class="testi-prev" aria-label="Previous testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg></button>
          <button class="testi-next" aria-label="Next testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg></button>
        </div>
        <div class="testi-dots"></div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1600&auto=format&fit=crop" alt="" loading="lazy">
        <h2>Ready to Explore Siaya?</h2>
        <p>Find your perfect escape — or talk to us and we'll help you plan the trip.</p>
        <div style="display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap">
          <a href="/properties" class="btn btn-gold">Find a Stay</a>
          <a href="/contact" class="btn btn-light">Talk to Us</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { settings }) %>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  (function () {
    const el = document.getElementById('home-map');
    if (!el || typeof L === 'undefined') return;

    const props = <%- escapeJson(allProperties) %>;
    const esc = (s) =>
      String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    const withCoords = props.filter((p) => p.lat && p.lng);
    if (!withCoords.length) return;

    const map = L.map(el, { scrollWheelZoom: false }).setView([0.058, 34.296], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);

    const markers = withCoords.map((p) => {
      const icon = L.divIcon({
        className: '',
        html: `<div style="background:#0e4f38;color:#fff;border:2px solid #d4af37;border-radius:50%;width:36px;height:36px;display:grid;place-items:center;font-weight:800;font-size:11px;box-shadow:0 4px 14px rgba(0,0,0,.35)">${(p.title || '?').slice(0, 1)}</div>`,
        iconSize: [36, 36],
        iconAnchor: [18, 18],
      });
      const m = L.marker([p.lat, p.lng], { icon }).addTo(map);
      const img = (p.images && p.images[0]) || '/static/img/placeholder.svg';
      m.bindPopup(
        `<div class="map-pop"><a href="/properties/${esc(p.slug)}"><img src="${esc(img)}" alt=""></a><b>${esc(p.title)}</b><span class="mp-price">KSh ${Number(p.pricePerNight).toLocaleString()}/night</span><small>${esc(p.location)}, ${esc(p.subCounty)}</small></div>`
      );
      return m;
    });

    if (markers.length > 1) {
      const bounds = L.featureGroup(markers).getBounds();
      map.fitBounds(bounds.pad(0.25));
    }

    // Enable scroll zoom only when hovering the map
    el.addEventListener('mouseenter', () => map.scrollWheelZoom.enable());
    el.addEventListener('mouseleave', () => map.scrollWheelZoom.disable());
  })();
</script>
</body>
</html>
