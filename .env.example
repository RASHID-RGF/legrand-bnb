# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas — connection string + database name
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=legrand

# Admin auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Seed admin account (used only on first run)
ADMIN_NAME=LeGrand Admin
ADMIN_EMAIL=admin@legrand.co.ke
ADMIN_PASSWORD=admin123
